# Majorana API + worker local development environment.
#
# Setup:
#   cp .env.example .env.local
#   Fill the blank secrets below. `.env.local` is gitignored.
#
# Keep provider keys in this backend file. Do not copy them into
# `apps/web/.env.local`, where they are unnecessary.

# Paste one disposable development database URL pair below, never production.
# `DATABASE_URL` is read by the API/worker, `DATABASE_URL_DIRECT` by Alembic
# only. Locally they are usually the same value.
# Local PostgreSQL: postgresql://postgres:<generated>@127.0.0.1:5432/majorana —
# `docs/runbooks/auth-dev.md § The local database` generates the password and the
# loopback-only container. Do not invent a memorable one, and do not use `localhost`
# in the container's `-p` flag, which publishes on every interface.
#
# Production is Cloud SQL (docs/runbooks/database.md) and reaches it over a Unix
# socket, so its URL has no host — the socket path is a query parameter. Nothing
# local needs that shape. Pointing this at production is refused by db.py only
# for Neon URLs; for everything else, don't.
DATABASE_URL=""
DATABASE_URL_DIRECT=""

# Future repository catalog authority. Generate three distinct UUIDs. Keep the
# feature disabled through Step 2; provisioning creates no catalog records.
SYSTEM_CATALOG_ENABLED="false"
SYSTEM_CATALOG_WORKSPACE_ID=""
SYSTEM_CATALOG_IMPORTER_USER_ID=""
SYSTEM_CATALOG_PUBLIC_READER_USER_ID=""

# The local auth and local sandbox seams fail closed outside development.
# WARNING: the local sandbox is a DEV/TEST double, not a production isolation
# boundary; generated code runs in a subprocess on this machine.
MAJORANA_ENV="development"
MAJORANA_LOCAL_DEV_AUTH="true"
MAJORANA_SANDBOX="local"
WEB_ORIGIN="http://localhost:3000"

# Expected `aud` on WorkOS access tokens. EMPTY LEAVES THE CLAIM UNCHECKED,
# which is the behaviour that shipped before the pin existed. Setting it makes
# `aud` required as well as pinned, so read the value off a real token before
# setting it in an environment that people sign in to — a wrong value refuses
# every request, sign-in included, on a service that looks perfectly healthy:
#
#   Sign in, then in the browser console:
#     JSON.parse(atob(<access token>.split(".")[1])).aud
#
#   No `aud` in the payload means WorkOS is not issuing one for this client.
#   Leave this empty in that case; do not invent a value.
WORKOS_JWT_AUDIENCE=""

# Anonymous requests per minute per source address (services/api rate_limit.py).
# Only credential-less traffic is counted, so it cannot throttle a signed-in
# user. 0 disables the limiter — the escape hatch if it ever refuses real
# readers. Default 1200 (this said 240 until 2026-08-06; the code default had
# moved and this file had not).
ANON_RATE_LIMIT_PER_MINUTE=""

# Lets our own server-side renderer out of the ANONYMOUS bucket above.
#
# Nothing in a browser calls /v1/catalog/*, so without this the limiter's whole
# subject is Vercel's SSR egress — a few addresses shared by every visitor at
# once — and tripping it is SILENT: the web app catches the 429 and serves the
# committed static corpus, so a launch produces a catalog that is quietly stale
# rather than an error anybody sees.
#
# Set the SAME value in two places or it buys nothing:
#   - TRUSTED_CALLER_TOKEN          on the api Cloud Run service (Secret Manager)
#   - MAJORANA_TRUSTED_CALLER_TOKEN on the Vercel project (all environments)
#
# It is not a credential: it grants no read an anonymous caller cannot already
# make, only a separate rate-limit bucket. It still has a real secret's rules —
# min 32 chars, no placeholder from this public repo, and it may not equal
# DEPLOY_PROBE_TOKEN, which CAN create runs.
#
# Verify after deploying, rather than assuming (the failure is silent):
#   curl -sI https://<api>/v1/catalog/entries -H "X-Majorana-Trusted-Caller: $TOKEN" \
#     | grep -i x-majorana-caller-trust      # expect: trusted
# Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
TRUSTED_CALLER_TOKEN=""
MAJORANA_TRUSTED_CALLER_TOKEN=""

# Requests per minute for a caller that presented the token above. Default 20000.
# This is a backstop against OUR OWN render path looping, not protection against
# a leaked token — 20000/min is 333 requests a second, which reads the whole
# 283-record corpus hundreds of times over. The control for a leaked token is
# rotating it.
TRUSTED_RATE_LIMIT_PER_MINUTE=""

# Production-default provider profile: OpenAI for planning/review and DeepSeek
# for generation. Both keys are required for the complete default pipeline.
MAJORANA_LLM_PROVIDER="openai"
OPENAI_API_KEY=""
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Alternative single-provider profile. If selected, change
# MAJORANA_LLM_PROVIDER above to `anthropic` and fill this value instead.
ANTHROPIC_API_KEY=""

# Only required when MAJORANA_LOCAL_DEV_AUTH is false and real WorkOS JWTs are
# sent to the API. The web-side WorkOS values live in apps/web/.env.local.
WORKOS_CLIENT_ID=""

# Tier allowlists. Read by the API and the worker from `TIER_ALLOWLIST_ENV`
# (services/api/src/majorana_api/tiers.py), and by apps/web from the same three
# names — one value set in two places rather than two values in two places.
# Comma- or whitespace-separated; matching is case-insensitive.
#
# Empty here and with no default in code: this repository is public, so
# collaborator addresses belong in the deployment environment only. A missing
# list meters those accounts like free ones, which is visible and recoverable;
# it can never lock the operator out, whose identity is recognised without any
# configuration (OPERATOR_IDENTITIES).
#
# The names are the internal tier ids, NOT the plan names on the pricing page:
# `pro` is sold as Plus and `team` as Professional. An address on two lists
# resolves to the more capable tier. None of them grants hardware submission —
# that stays fail-closed behind MAJORANA_QPU_SUBMIT_ENABLED, the runtime
# package, and the caller's OWN connected IBM credential, none of which any tier
# can bypass. There is no deployment-wide provider token to inherit.
LEONA_DEVELOPER_EMAILS=
LEONA_PRO_EMAILS=
LEONA_TEAM_EMAILS=

# Post-deploy probe credential (docs/runbooks/deploys.md § Post-deploy synthetic
# run). Empty everywhere but production, where it is a Secret Manager entry on
# the api service. It may create a run and read that run back — every other route
# answers 403. The API refuses to start on a value shorter than 32 chars or on a
# placeholder that appears in this public repository.
# Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
DEPLOY_PROBE_TOKEN=""

# Encryption keys for stored third-party provider credentials (IBM Quantum API
# keys, migration 0045). Comma-separated Fernet keys, NEWEST FIRST: the first
# key encrypts, any key decrypts, which is what makes rotation possible without
# a downtime window — prepend the new key, keep the old one until every row's
# key_id names the new one, then drop the old one. REPLACING the value rather
# than prepending makes every stored credential undecryptable at once.
#
# Required on BOTH the api service (to store) and the worker service (to
# decrypt at submission time). Unset, the connect endpoint answers 503
# credential_storage_unavailable and no hardware submission is possible; it
# never falls back to storing plaintext.
#
# Generate with: uv run python -m majorana_api.credential_crypto
MAJORANA_CREDENTIAL_KEYS=

# Hardware submission, deployment-wide. `false`/unset means POST
# /v1/qpu/submissions refuses with blocked_reason=submission_disabled, on every
# account. There is NO operator-owned IBM token any more: each user connects
# their own free IBM Quantum API key at PUT /v1/qpu/credentials, so IBM's Open
# Plan allowance (10 minutes of QPU time per 28-day rolling window) is per
# account rather than shared by the whole platform. Set on api and worker.
MAJORANA_QPU_SUBMIT_ENABLED=false

# Implicit arXiv research during planning, worker only. UNSET MEANS ON — this
# is a kill switch, not an opt-in, and the enabled state is the one that was
# cleared for launch. Set it to anything that is not `1 true yes on enabled`
# and the worker stops asking the model whether a run needs literature at all,
# which also stops it paying for the triage call. Reach for this if arXiv is
# slow or down: a lookup is already bounded at 15s and degrades to planning
# without research, so an outage should cost latency rather than runs, and this
# is the switch for when that turns out not to be true.
MAJORANA_RESEARCH="true"

# Optional observability. Blank values keep integrations inert.
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_EXPORTER_OTLP_HEADERS=""
