# News renderer: no DB access, no OpenAI calls.
HOST=127.0.0.1
PORT=3100
SITE_URL=https://news.leonaquantum.com
# preview (samples), editor (loopback only), or published (real public articles only).
LEONA_NEWS_MODE=preview
LEONA_NEWS_API_URL=http://127.0.0.1:8000
# Existing WorkOS bearer for a newsroom admin; local editor mode only.
# Never put this token in a public deployment or in browser code.
LEONA_NEWS_EDITOR_TOKEN=

# Existing API and Worker processes need these settings, not just the renderer.
LEONA_NEWS_ENABLED=false
LEONA_NEWS_WORKSPACE_ID=
LEONA_NEWS_PUBLIC=false
LEONA_NEWS_DAILY_BATCH_LIMIT=3

# Worker only. Keep the real key in your local .env / deployed worker secret.
OPENAI_API_KEY=
LEONA_NEWS_MODEL=gpt-5.5
LEONA_NEWS_IMAGE_MODEL=gpt-image-2.5-flare
LEONA_NEWS_ARXIV_ENABLED=false
LEONA_NEWS_SCHEDULE_ENABLED=false
LEONA_NEWS_INTERVAL_HOURS=8
LEONA_NEWS_EDITOR_USER_ID=
LEONA_NEWS_AUTO_PUBLISH=false
