# Copy to .env.local (gitignored). Values from the WorkOS dashboard
# (project `majorana`) — owner-run; never commit real values.
WORKOS_CLIENT_ID="client_..."
WORKOS_API_KEY="sk_test_..."
# 32+ chars; generate locally: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=""
# Must be registered as a redirect URI in the WorkOS dashboard
NEXT_PUBLIC_WORKOS_REDIRECT_URI="http://localhost:3000/auth/callback"
# FastAPI control plane
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Explicit local-only bypass. Next requires NODE_ENV=development and the API
# requires MAJORANA_ENV=development; production/CI/Vercel processes reject it.
MAJORANA_LOCAL_DEV_AUTH="false"

# Accounts granted the "developer" tier: unlimited agent runs and private
# artifacts, and the widest browser-simulation ceiling. Comma- or
# whitespace-separated; matching is case-insensitive.
#
# Intentionally EMPTY here and with no default in code. This repository is
# public, so collaborator addresses belong in the deployment environment only —
# apps/web/lib/account-tier.test.ts fails if a default ever appears.
#
# The tier is a PRODUCT allowance. It grants no hardware-submission capability:
# real QPU submission stays fail-closed behind MAJORANA_QPU_SUBMIT_ENABLED, an
# IBM token, and the runtime package, none of which any tier can bypass.
LEONA_DEVELOPER_EMAILS=""

# Addresses granted the TEAM tier — the plan that includes sharing a project
# with somebody outside the workspace that owns it, 250 artifacts, and 50 runs
# a week. Same parsing, same public-repo rule: empty here, real values in the
# deployment only.
#
# `users.plan = 'team'` is the durable signal and is what billing will write.
# This exists because nothing writes it today, so without it an operator can
# only put a design partner on the tier by hand in SQL. An address on both
# lists resolves to developer.
#
# Set it in BOTH places or neither: the control plane reads its own copy, and
# the app that has it while the API does not shows a Share button that 403s.
LEONA_TEAM_EMAILS=""

# Observability (AD-10) — all optional; unset = fully inert. Real values live in
# ~/Documents/Projects/Majorana/secrets/observability.env (Sentry org majorana-ms,
# Grafana Cloud stack yellowwildebeest692).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_EXPORTER_OTLP_HEADERS=""
