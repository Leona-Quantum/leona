# How big the deployed fleet is. THIS FILE IS THE ONLY PLACE THESE NUMBERS LIVE.
#
# `.github/workflows/deploy.yml` loads it into the job environment and passes
# every value straight to `gcloud run deploy`, and
# `majorana_api.db.fleet_sizing()` parses it for the connection-budget
# arithmetic. Changing a number here changes what production runs on the next
# push to `dev` — there is no second copy to keep in step.
#
# Format is deliberately boring: KEY=INTEGER, one per line, no quotes, no
# expansion. It has to be readable by `sh`, by GitHub Actions' $GITHUB_ENV, and
# by a five-line Python parser, and anything cleverer than this is readable by
# fewer of the three.
#
# It is NOT copied into the container image (services/api/Dockerfile copies
# services/, packages/py/, evals/harness/ and db/ — not infra/). That is fine
# and deliberate: nothing on a request path reads it. See db.py's fleet_sizing()
# docstring, and test_no_runtime_module_reads_the_fleet_file, which enforces it.
#
# ----------------------------------------------------------------------------
# THE ONE KNOB: how many always-on worker instances process the run queue.
# ----------------------------------------------------------------------------
# 1 = serial. One run at a time, product-wide. This is the default, because at
#     today's usage the queue is empty and each extra always-on instance is
#     roughly $15-25/month of Cloud Run for an idle poller.
# 3 = the stress-test setting. Runs process three-at-a-time. The queue itself
#     has always supported this: `claim_job` and `claim_pending_dead_letter` are
#     FOR UPDATE SKIP LOCKED with lease tokens and heartbeats, `recover_stale_jobs`
#     repeats its predicates on both UPDATEs, the orphan reaper writes
#     deterministic uuid5 event ids onto a `fail_run_from_dead_letter` that
#     no-ops on an already-terminal run, and `worker_id` is "$hostname:$pid" so
#     instances never collide on a lease. Verified 2026-08-01, ran in production
#     at 3 between then and the same day.
# 4 = does NOT fit, and the blocker is the deploy rather than the workload.
#     `--min-instances` is a REVISION-level setting: while a `gcloud run deploy`
#     is in flight the outgoing revision is still in the traffic split and still
#     holding its minimum, so the fleet transiently runs 2xN workers. Four is 36
#     connections at rest and 52 against a budget of 45 for the length of every
#     deploy — and a deploy is exactly when Alembic needs one. Buying a fourth
#     means shrinking the API pool, raising the database tier, or draining the
#     old worker revision first. `test_where_the_worker_count_actually_runs_out`
#     pins that boundary, so raising this past what fits fails CI rather than
#     production.
#
# To switch: edit the one line below, commit, push to `dev`. Nothing else.
WORKER_INSTANCES=1

# Sessions each worker instance holds at once: the job handler plus the
# concurrent heartbeat that fences its lease (`_execute_with_heartbeat`).
# Everything else in the loop opens one session and closes it before the next.
# Deployed as DB_POOL_SIZE/DB_MAX_OVERFLOW on the worker service, which is the
# only reason they take effect — they are not defaults in code.
WORKER_POOL_SIZE=2
WORKER_MAX_OVERFLOW=2

# The API's Cloud Run ceiling. Each instance can reach DEFAULT_POOL_SIZE +
# DEFAULT_MAX_OVERFLOW connections (db.py), so this is a term in the budget.
API_MAX_INSTANCES=2

# The API's per-instance shape — CPU, memory, request concurrency. Like
# API_MAX_INSTANCES above, this used to be live-service state: the "deploy api
# (no traffic)" step in deploy.yml never passed --cpu/--memory/--concurrency,
# so `gcloud run deploy --image` silently kept whatever the previous revision
# happened to have, and the real numbers lived only in whichever manual
# `gcloud` command last touched the service. Pinned 2026-08-14 from the live
# values (`gcloud run services describe majorana-api --region us-west1`).
#
# API_CPU is whole vCPUs — gcloud's --cpu accepts a bare integer, and the live
# value (`1000m`) is exactly 1. API_MEMORY_MI is mebibytes: the loader below
# only accepts KEY=INTEGER, so it cannot hold "512Mi" as one token — the
# deploy step appends the unit itself: --memory "${API_MEMORY_MI}Mi".
# API_CONCURRENCY is requests per instance before Cloud Run starts a new one.
#
# It was 80 — Cloud Run's own default, and 8x what an instance can actually
# execute. Each instance opens at most DEFAULT_POOL_SIZE + DEFAULT_MAX_OVERFLOW
# = 10 Postgres connections (db.py), and every request on the public catalog
# path touches the database, so the 11th concurrent request on an instance
# waits on pool checkout rather than on anything Cloud Run can see.
#
# The cost of that is not the waiting, which has to happen somewhere. It is
# WHERE: a request blocked inside the container is already admitted, so Cloud
# Run counts the instance as serving it and does not start a second instance
# until utilisation stays high. With a ceiling of 80, a single instance can
# absorb an entire 100-request burst and the second instance — the one
# `API_MAX_INSTANCES` was bought for — never starts. Ten connections then serve
# the whole burst instead of twenty.
#
# 16 is 1.6x the pool: enough overcommit that a request needing no database
# (health, a 404, a validation refusal) is not queued behind ten that do, and
# close enough that admission approximately matches what the instance can
# execute. Anything at or below 10 would starve those cheap requests; 24 or 32
# would also force the second instance and are the reasonable fallbacks if 16
# proves tight.
#
# What this does NOT change is the connection budget: concurrency is not a term
# in it, and `fleet_peak_connections()` does not read this key. The ceiling on
# concurrent DB work is still API_MAX_INSTANCES x 10 = 20 either way. This
# changes which of the two instances is doing it.
#
# **This is the one change in this lane argued rather than measured**, and the
# reason is stated so the next person can close it: the effect is a Cloud Run
# autoscaler behaviour, and `bench/k6/run-capacity.sh` runs against a single
# local uvicorn process where `containerConcurrency` does not exist. The
# supporting measurement that DOES exist is the one that rules out the
# alternative — cutting the response body by 60% moved the p95 by nothing
# (docs/gates/capacity-100-users.md), so the constraint is the pool, and the
# pool is what this puts more of the fleet behind. To revert: set this back to
# 80 and push; it is one line and it takes effect on the next deploy.
#
# Not a term in the connection budget above — CPU/memory/concurrency don't
# affect how many Postgres connections an instance opens, only how much work
# it does per request. fleet_sizing() in db.py does not read these.
API_CPU=1
API_MEMORY_MI=512
API_CONCURRENCY=16

# db-g1-small allows 50 connections and reserves 3 for superusers. Two more are
# held back for a deploy's Alembic step and one operator with psql. Raising the
# database tier is the only thing that moves the ceiling.
INSTANCE_CONNECTION_CEILING=50
SUPERUSER_RESERVED=3
OPERATIONAL_HEADROOM=2
