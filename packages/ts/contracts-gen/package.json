{
  "name": "@majorana/contracts-gen",
  "version": "0.0.0",
  "private": true,
  "description": "GENERATED TS types from packages/py/contracts/openapi.json — never hand-edit",
  "type": "module",
  "main": "src/schema.d.ts",
  "types": "src/schema.d.ts",
  "scripts": {
    "gen": "openapi-typescript ../../py/contracts/openapi.json -o src/schema.d.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.9.3"
  }
}
